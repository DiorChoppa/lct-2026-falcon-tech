# Скопировать в .env для локальной разработки вне Docker.
# DB_PORT — порт БД из compose на хосте; поменять, если 5432 занят локальным Postgres.
DB_PORT=5432
# shared_buffers Postgres; для `just ann-bench` на 10^6 ставить 2GB
PG_SHARED_BUFFERS=512MB
# БД нужна bench/ann_bench.py; gallery/search читают GALLERY__DATABASE__URL /
# SEARCH__DATABASE__URL (или config/development.toml), api-gateway в БД не ходит.
DATABASE_URL=postgres://reid:reid@localhost:5432/reid
# api-gateway вне Docker: адреса gRPC-сервисов и общий каталог кропов
# (gallery/search по умолчанию пишут в file:///tmp/crops/..., см. их config/).
GALLERY_URL=http://localhost:50054
SEARCH_URL=http://localhost:50053
INFERENCE_URL=http://localhost:50051
CROPS_DIR=/tmp/crops
# Порог отказа — `threshold` в models/model.json: применяет его search,
# api-gateway только показывает в ответе /api/search (MODEL_MANIFEST).
# inference/gallery/search конфигурируются через crates/<svc>/config/*.toml
# + переменные <SVC>__<SECTION>__<KEY> (см. infrastructure/setup/config.rs).
RUST_LOG=info
# Публичный инстанс (deploy/vm/): basic auth в nginx web; пустые — без пароля.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
WEB_PORT=3000
# Ключ Яндекс Карт (JavaScript API) для экрана «Маршрут ТС»; пустой — карта-заглушка.
# Для `npm run dev` — VITE_YMAPS_KEY в web/.env.local.
YMAPS_KEY=
