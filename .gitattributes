# Preserve model runtime sources and validation fixtures byte-for-byte across OSes.
ml/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
dataset/*.csv -text
submission/*.csv -text

# Model weights (607 MB) are stored in Git LFS: run `git lfs install && git lfs pull`.
models/model.onnx filter=lfs diff=lfs merge=lfs -text

# The OpenAPI contract test compares generated bytes on every platform.
docs/openapi.json text eol=lf
models/model.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
models/policy.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
models/DINOV3_LICENSE.md -text
